# Router host and default credentials used for SSH access.
ASUSWRT_HOST=192.168.1.1
ASUSWRT_USERNAME=admin
ASUSWRT_PASSWORD=

# SSH is the only transport used by the server.
ASUSWRT_SSH_PORT=22
ASUSWRT_SSH_USERNAME=
ASUSWRT_SSH_PASSWORD=
ASUSWRT_SSH_KEY_FILE=

# Mutations are disabled unless this is explicitly true.
ASUSWRT_ALLOW_MUTATIONS=false
ASUSWRT_TIMEOUT_SECONDS=10
ASUSWRT_CACHE_SECONDS=5
